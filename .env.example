VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudflare Worker URL for RSS proxy (optional, falls back to allorigins)
VITE_RSS_PROXY_URL=

# VAPID key from Firebase Console > Cloud Messaging > Web Push certificates
VITE_VAPID_KEY=

# YouTube Data API v3 key for channel search (optional, enables channel search by name)
# Get one at https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=
